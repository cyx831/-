`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// win_engine_wide (two-tile prefetch, 4 buffers)
//
//   cur  : current tile pair read
//   nxt1 : next tile (already filled)
//   nxt2 : tile being filled (2 tiles ahead)
//
//   The tile reader takes >256 pclk per window (DDR/CDC per row), so a
//   one-tile lookahead is not enough.  nxt2 is filled during the current tile;
//   nxt1 is already complete.  At tile_advance:
//       cur<=nxt1; nxt1<=nxt2; nxt2<=nxt2+1
//
//   Initial prefill:
//       reset: nxt2=0, fill tile0
//       prefill_adv: nxt2=1, fill tile1
//       start: cur=0 (pre0), nxt1=1 (pre1), nxt2=2
//////////////////////////////////////////////////////////////////////////////////
module win_engine_wide #(
    parameter TILES = 3600,
    parameter TILE  = 16,
    parameter WIN   = 32
)(
    input               pclk,
    input               rstn,
    input               frame_start,
    input               tile_advance,
    input               start,
    input               prefill_adv,

    output [11:0]       tile_idx,
    output [11:0]       win_x0,
    output [11:0]       win_y0,
    output [11:0]       next_win_x0,
    output [11:0]       next_win_y0,
    output              next_tile_valid,
    output reg          win_ready,
    output wire         nxt1_ready,
    output wire         nxt2_ready,

    // fill port: nxt2 tile's 32x32 window
    input               fill_we,
    input      [4:0]    fill_row,
    input      [1:0]    fill_col8,
    input      [127:0]  fill_data,
    input               fill_done,

    // pair read: current tile's window
    input      [9:0]    src_x,
    input      [9:0]    src_y,
    output reg [63:0]   row0_pair,
    output reg [63:0]   row1_pair,
    output reg          win_valid
);

    reg [11:0] cur_idx, nxt1_idx, nxt2_idx;
    reg [11:0] cur_x0, cur_y0;
    reg [11:0] nxt1_x0, nxt1_y0;
    reg [11:0] nxt2_x0, nxt2_y0;
    reg [11:0] pre0_x0, pre0_y0, pre1_x0, pre1_y0;

    assign tile_idx = cur_idx;
    assign win_x0   = cur_x0;
    assign win_y0   = cur_y0;

    //------------------------------------------------------------------
    // bbox table for nxt2 (the tile being filled)
    //------------------------------------------------------------------
    wire [11:0] bx0, by0;
    wire        bvalid;

    bbox_rom #(
        .TILES  (TILES),
        .ADDR_W (12)
    ) u_bbox_rom (
        .clk        (pclk),
        .tile_idx   (nxt2_idx),
        .win_x0     (bx0),
        .win_y0     (by0),
        .tile_valid (bvalid)
    );

    assign next_win_x0     = bx0;
    assign next_win_y0     = by0;
    assign next_tile_valid = bvalid;

    //------------------------------------------------------------------
    // pointers / ready FIFO
    //   rdy0/rdy1 are the ready tokens for nxt1/nxt2.  A fill can finish
    //   after nxt2 has advanced; the token stays in the FIFO and is popped
    //   at the tile_advance when that tile becomes current.
    //------------------------------------------------------------------
    reg        rdy0, rdy1;
    reg [1:0]  rdy_cnt;

    assign nxt1_ready = rdy0;
    assign nxt2_ready = rdy1;

    always @(posedge pclk) begin
        if (!rstn || frame_start) begin
            cur_idx     <= 12'd0;
            nxt1_idx    <= 12'd0;
            nxt2_idx    <= 12'd0;
            cur_x0      <= 12'd0;
            cur_y0      <= 12'd0;
            nxt1_x0     <= 12'd0;
            nxt1_y0     <= 12'd0;
            nxt2_x0     <= 12'd0;
            nxt2_y0     <= 12'd0;
            pre0_x0     <= 12'd0;
            pre0_y0     <= 12'd0;
            pre1_x0     <= 12'd0;
            pre1_y0     <= 12'd0;
            win_ready   <= 1'b0;
            rdy0        <= 1'b0;
            rdy1        <= 1'b0;
            rdy_cnt     <= 2'd0;
        end
        else if (prefill_adv) begin
            nxt2_idx <= (nxt2_idx == TILES-1) ? 12'd0 : nxt2_idx + 12'd1;
        end
        else if (start) begin
            cur_idx   <= 12'd0;
            cur_x0    <= pre0_x0;
            cur_y0    <= pre0_y0;
            nxt1_idx  <= 12'd1;
            nxt1_x0   <= pre1_x0;
            nxt1_y0   <= pre1_y0;
            nxt2_idx  <= 12'd2;
            win_ready <= 1'b1;
            rdy0      <= rdy1;   // tile1 token
            rdy1      <= 1'b0;
            rdy_cnt   <= (rdy_cnt > 2'd0) ? 2'd1 : 2'd0;
        end
        else if (tile_advance) begin
            cur_idx    <= nxt1_idx;
            cur_x0     <= nxt1_x0;
            cur_y0     <= nxt1_y0;
            win_ready  <= rdy0;
            nxt1_idx   <= nxt2_idx;
            nxt1_x0    <= nxt2_x0;
            nxt1_y0    <= nxt2_y0;
            nxt2_idx   <= (nxt2_idx == TILES-1) ? 12'd0 : nxt2_idx + 12'd1;
            rdy0       <= rdy1;
            rdy1       <= 1'b0;
            rdy_cnt    <= (rdy_cnt > 2'd0) ? rdy_cnt - 2'd1 : 2'd0;
        end
        else if (fill_done) begin
            nxt2_x0 <= bx0;
            nxt2_y0 <= by0;
            if (rdy_cnt == 2'd0) begin
                rdy0    <= 1'b1;
                rdy_cnt <= 2'd1;
            end
            else begin
                rdy1    <= 1'b1;
                rdy_cnt <= 2'd2;
            end
            if (nxt2_idx == 12'd0) begin
                pre0_x0 <= bx0;
                pre0_y0 <= by0;
            end
            if (nxt2_idx == 12'd1) begin
                pre1_x0 <= bx0;
                pre1_y0 <= by0;
            end
        end
    end

    //------------------------------------------------------------------
    // 4 x 32 x 32 window memory
    //------------------------------------------------------------------
    reg [15:0] mem [0:4095];
    wire [1:0]  fill_buf = nxt2_idx[1:0];
    wire [11:0] wbase = {fill_buf, fill_row, fill_col8, 3'b000};
    integer fk;

    always @(posedge pclk) begin
        if (fill_we)
            for (fk = 0; fk < 8; fk = fk + 1)
                mem[wbase + fk] <= fill_data[fk*16 +: 16];
    end

    //------------------------------------------------------------------
    // pair read pipeline (2 pclk), current buffer
    //------------------------------------------------------------------
    reg [9:0] sx_d1, sy_d1;
    reg [1:0] buf_d1;
    reg       ready_d1;

    always @(posedge pclk) begin
        sx_d1    <= src_x;
        sy_d1    <= src_y;
        buf_d1   <= cur_idx[1:0];
        ready_d1 <= win_ready;
    end

    wire [4:0] k  = sx_d1[4:1];
    wire [5:0] i0 = {1'b0, k, 1'b0};
    wire [5:0] i1 = i0 + 6'd1;
    wire [5:0] i2 = i0 + 6'd2;
    wire [5:0] i3 = i0 + 6'd3;

    wire [4:0] r1y = sy_d1[4:0] + 5'd1;

    wire [15:0] r0p0 = (i0 < 6'd32) ? mem[{buf_d1, sy_d1[4:0], i0[4:0]}] : 16'd0;
    wire [15:0] r0p1 = (i1 < 6'd32) ? mem[{buf_d1, sy_d1[4:0], i1[4:0]}] : 16'd0;
    wire [15:0] r0p2 = (i2 < 6'd32) ? mem[{buf_d1, sy_d1[4:0], i2[4:0]}] : 16'd0;
    wire [15:0] r0p3 = (i3 < 6'd32) ? mem[{buf_d1, sy_d1[4:0], i3[4:0]}] : 16'd0;
    wire [15:0] r1p0 = (i0 < 6'd32) ? mem[{buf_d1, r1y, i0[4:0]}] : 16'd0;
    wire [15:0] r1p1 = (i1 < 6'd32) ? mem[{buf_d1, r1y, i1[4:0]}] : 16'd0;
    wire [15:0] r1p2 = (i2 < 6'd32) ? mem[{buf_d1, r1y, i2[4:0]}] : 16'd0;
    wire [15:0] r1p3 = (i3 < 6'd32) ? mem[{buf_d1, r1y, i3[4:0]}] : 16'd0;

    always @(posedge pclk) begin
        if (!rstn) begin
            row0_pair <= 64'd0;
            row1_pair <= 64'd0;
            win_valid <= 1'b0;
        end
        else begin
            row0_pair <= {r0p3, r0p2, r0p1, r0p0};
            row1_pair <= {r1p3, r1p2, r1p1, r1p0};
            win_valid <= ready_d1 && (sx_d1 < 10'd31) && (sy_d1 < 10'd31);
        end
    end

endmodule
